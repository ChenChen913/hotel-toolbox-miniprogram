/* 源实现：src/components/Stepper.vue（尺寸 1px ≈ 2rpx） */
.stepper {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
/* 视觉按钮 62rpx，外层 88rpx 透明热区：满足 02 §6「所有可点元素最小高度 ≥44px」 */
.stwrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
}
.st {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  border: 1rpx solid var(--glass-border);
  color: var(--pine-deep);
  background: linear-gradient(150deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.5));
  box-shadow: 0 4rpx 16rpx -4rpx rgba(28, 45, 38, 0.2), inset 0 1rpx 0 #fff;
  font-size: 32rpx;
  line-height: 1;
  transition: transform 0.15s;
}
.stwrap-hover .st {
  transform: scale(0.92);
}
.st.off {
  opacity: 0.35;
}
.val {
  min-width: 60rpx;
  text-align: center;
  font-size: 33rpx;
  font-weight: 650;
  color: var(--ink);
}
.unit {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}
