{
  "name": "hotel-miniprogram",
  "version": "1.0.0",
  "private": true,
  "description": "酒店入住工具箱 · 微信小程序（原生 + TypeScript，零网络、零账号、零第三方运行时依赖）",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p miniprogram --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "diff:data": "diff \"D:/hotel/src/data.ts\" \"miniprogram/core/data.ts\"",
    "diff:types": "diff \"D:/hotel/src/types.ts\" \"miniprogram/core/types.ts\"",
    "diff:engine": "diff \"D:/hotel/src/engine.ts\" \"miniprogram/core/engine.ts\"",
    "icons": "python tools/gen-icons.py",
    "check:icons": "python tools/check-icons.py",
    "check:wxs": "python tools/check-wxs.py",
    "check:wxml": "python tools/check-wxml.py"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "miniprogram-api-typings": "^5.2.3",
    "typescript": "~5.7.2",
    "vitest": "^3.0.5"
  }
}
